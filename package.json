{
  "name": "ctf-agent",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript workspace for the z3gh0ne hub/backend refactor.",
  "workspaces": [
    "backend",
    "product",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace backend",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "npm run smoke --workspace backend",
    "match:test": "cd backend/match_backend && python3 -m unittest -v",
    "match:api": "cd backend/match_backend && python3 -m ctf_platforms.server",
    "frontend:dev": "npm run dev --workspace frontend",
    "frontend:build": "npm run build --workspace frontend",
    "frontend:preview": "npm run preview --workspace frontend"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bygeee/My-agent.git"
  },
  "license": "ISC"
}
